        <div><a name="_generational_name_2" id="_generational_name_2"></a><p class="h2Annex">A.6 Generational name</p>

  
  <p style="mso-list:l3 level1 lfo18;" class="MsoListParagraphCxSpFirst">
    Junior
  </p>
  <p style="mso-list:l3 level1 lfo18;" class="MsoListParagraphCxSpMiddle">
    Senior
  </p>
  <p style="mso-list:l3 level1 lfo18;" class="MsoListParagraphCxSpLast">
    Numerical
  </p>

</div>
