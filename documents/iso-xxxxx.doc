      <div class="Section3"><a name="AnnexA" id="AnnexA"></a>
        <h1 class="Annex"><b>Annex B</b><br/>(normative)<br/><br/><b>Honorific types</b></h1>
        <div><a name="_general_7" id="_general_7"></a><p class="h2Annex">B.1 General</p><div><a name="_mister" id="_mister"></a><p class="h3Annex">B.1.1 Mister</p><table class="dl"><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Code</p></td><td valign="top">
    <p class="MsoNormal"><a name="_93e28289-3fd2-4cd7-bfd7-0fbe34b5a4f7" id="_93e28289-3fd2-4cd7-bfd7-0fbe34b5a4f7"></a>urn:iso:name:honorific:general:mr</p>
  </td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Description</p></td><td valign="top">
    <p class="MsoNormal"><a name="_7368a9c8-affe-408b-8cbe-e293251ee0b0" id="_7368a9c8-affe-408b-8cbe-e293251ee0b0"></a>commonly used English honorific for men</p>
  </td></tr></table>
<div class="example"><a name="_8959fbac-b41f-438b-9ccc-0dee2d7bb378" id="_8959fbac-b41f-438b-9ccc-0dee2d7bb378"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Mr. Smith</p></div>
<div class="example"><a name="_2ba2e792-16a3-4930-b0f4-5c12f7cfc420" id="_2ba2e792-16a3-4930-b0f4-5c12f7cfc420"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Mr Smith</p></div>
<p class="TableTitle" align="center">Table B.1</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_e843dfcb-9d15-4364-8f3b-f9bdce60adb8" id="_e843dfcb-9d15-4364-8f3b-f9bdce60adb8"></a><thead><tr><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Language</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Abbreviations</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Rendered</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Position</th></tr></thead><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">en</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Mr, Mr.</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Mr</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Prefix</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">fr</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">M., Mssr.</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Monsieur</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Prefix</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">de</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;"></td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Herr</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Prefix</td></tr></tbody></table></div></div>
<div><a name="_mrs" id="_mrs"></a><p class="h3Annex">B.1.2 Mrs</p><table class="dl"><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Code</p></td><td valign="top">
    <p class="MsoNormal"><a name="_b3ad5c93-98f2-45c0-98da-2673d537f2f1" id="_b3ad5c93-98f2-45c0-98da-2673d537f2f1"></a>urn:iso:name:honorific:general:mrs</p>
  </td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Description</p></td><td valign="top">
    <p class="MsoNormal"><a name="_09b752f1-f33d-493a-8a39-bbb05a9694b3" id="_09b752f1-f33d-493a-8a39-bbb05a9694b3"></a>commonly used English honorific for women. Originated from &#x201C;Mistress&#x201D;.</p>
  </td></tr></table>
