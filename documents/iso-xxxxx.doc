ce-b4a0-076578726a83" id="_a52b3113-3f08-40ce-b4a0-076578726a83"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x912D;</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x91AB;&#x751F;</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">title</td></tr></tbody></table></div><p class="TableTitle" align="center">Table C.23</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_9be8d0c8-3a79-441f-bf99-06f925a4ecf0" id="_9be8d0c8-3a79-441f-bf99-06f925a4ecf0"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x963F;</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x738B;</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;"></td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div></div></div></div>
        <div><a name="_colombian" id="_colombian"></a><p class="h2Annex">C.9 Colombian</p>

</div>
        <div><a name="_czech" id="_czech"></a><p class="h2Annex">C.10 Czech</p>

</div>
        <div><a name="_english" id="_english"></a><p class="h2Annex">C.11 English</p><p class="MsoNormal"><a name="_cd07e1c3-f057-4435-900f-ae2e5a84b67e" id="_cd07e1c3-f057-4435-900f-ae2e5a84b67e"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo18;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo18;" class="MsoListParagraphCxSpLast">
    family name
  </p>

<p class="MsoNormal"><a name="_7672b367-bbb0-4d61-a048-74d69aaf6f37" id="_7672b367-bbb0-4d61-a048-74d69aaf6f37"></a>English names are names used in, or originating in, England. In England as
elsewhere in the English-speaking world, a complete name usually consists of a
given name, commonly referred to as a first name or Christian name, and a (most
commonly patrilineal) family name or surname, also referred to as a last name.</p>
<p class="MsoNormal"><a name="_cf46e5af-b351-4f7c-bcf3-d8455b7e7520" id="_cf46e5af-b351-4f7c-bcf3-d8455b7e7520"></a>There can be several given names, some of these being often referred to as a
second name, or middle name(s).</p>
<p class="MsoNormal"><a name="_039f0f4f-9c79-444c-b0c7-1e2418acc325" id="_039f0f4f-9c79-444c-b0c7-1e2418acc325"></a>Double-barrelled names, compound surnames in English feature two words,
are often joined by a hyphen or hyphens.</p>
<div><a name="_typical_name_patterns" id="_typical_name_patterns"></a><p class="h3Annex">C.11.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.24</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_e7a357c6-56c6-4af9-857c-20da5549038a" id="_e7a357c6-56c6-4af9-857c-20da5549038a"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div>
</div>
<div><a name="_examples" id="_examples"></a><p class="h3Annex">C.11.2 Examples</p><div class="example"><a name="_12226206-912c-4859-bcef-2a1a51381213" id="_12226206-912c-4859-bcef-2a1a51381213"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Henry Hepburne-Scott</p></div>
<p class="MsoNormal"><a name="_d4d51a07-9a43-433d-a840-3e7f2aa652bf" id="_d4d51a07-9a43-433d-a840-3e7f2aa652bf"></a>Some families having as many as
three or four words making up their surname.</p>
<div class="example"><a name="_6c740090-dc13-452a-b9b0-fa5959aa69aa" id="_6c740090-dc13-452a-b9b0-fa5959aa69aa"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Charles Hepburn-Stuart-Forbes-Trefusis, 21st Baron Clinton.</p></div>
<p class="MsoNormal"><a name="_d35d6ce2-3fb0-4cd6-93cb-b0cef7ec1b86" id="_d35d6ce2-3fb0-4cd6-93cb-b0cef7ec1b86"></a>It is not unusual for compound surnames to be composed of separate words
not linked by a hyphen.</p>
<div class="example"><a name="_47b38de9-ce04-4cf4-8b3e-585ba3700090" id="_47b38de9-ce04-4cf4-8b3e-585ba3700090"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span></p>
  <p class="TableTitle" align="center">Table C.25</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_ffa370ad-fb31-43f8-91e1-422c637128b0" id="_ffa370ad-fb31-43f8-91e1-422c637128b0"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Iain</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Duncan Smith</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div>
</div></div></div>
        <div><a name="_french" id="_french"></a><p class="h2Annex">C.12 French</p><p class="MsoNormal"><a name="_e449f430-1032-48c0-90da-6b299c38280d" id="_e449f430-1032-48c0-90da-6b299c38280d"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo19;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo19;" class="MsoListParagraphCxSpLast">
    given name
  </p>

<p class="MsoNormal"><a name="_872720b0-1806-4cfe-9133-fe8a5a9a0aec" id="_872720b0-1806-4cfe-9133-fe8a5a9a0aec"></a>French people have one, two or more given names (first names). One of them
is used in daily life.</p>
<div><a name="_typical_name_patterns_2" id="_typical_name_patterns_2"></a><p class="h3Annex">C.12.1 Typical name patterns</p><p class="TableTitle" align="center">Table C.26</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_a4af26ca-db5e-4721-bb84-db062cccf419" id="_a4af26ca-db5e-4721-bb84-db062cccf419"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td></tr></tbody></table></div>
<p class="TableTitle" align="center">Table C.27</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_9a27e4da-a5d2-45e0-9eb2-b881eba1912e" id="_9a27e4da-a5d2-45e0-9eb2-b881eba1912e"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div></div>
<div><a name="_examples_2" id="_examples_2"></a><p class="h3Annex">C.12.2 Examples</p><div class="example"><a name="_8ee7ab6f-c72f-4269-aa38-8bb9b699bd1a" id="_8ee7ab6f-c72f-4269-aa38-8bb9b699bd1a"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>&#x201C;Jacques Chirac&#x201D; instead of officially of Jacques Ren&#xE9; Chirac.</p></div>
<div class="example"><a name="_0dc28dc4-ef8f-4cc9-b173-b9c9da4f9f9c" id="_0dc28dc4-ef8f-4cc9-b173-b9c9da4f9f9c"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>&#x201C;Philippe P&#xE9;tain&#x201D; instead of officially of Henri Philippe P&#xE9;tain,
because Philippe was the given name that he used in daily
life.</p></div>
<p class="MsoNormal"><a name="_62d2be33-c838-4036-bdbe-2d79e986065a" id="_62d2be33-c838-4036-bdbe-2d79e986065a"></a>Middle names in the English sense do not exist, and middle initials are
never used for second or further given names.</p>
<div class="example"><a name="_45edda42-d3c8-4057-9612-20309d07b7b8" id="_45edda42-d3c8-4057-9612-20309d07b7b8"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>Claude All&#xE8;gre may be cited as &#x201C;Claude J. All&#xE8;gre&#x201D; in English-speaking
scientific publications, but not in French ones.</p></div></div></div>
        <div><a name="_german" id="_german"></a><p class="h2Annex">C.13 German</p><p class="MsoNormal"><a name="_8bf5ed34-a095-41fe-a680-3d6cefa48918" id="_8bf5ed34-a095-41fe-a680-3d6cefa48918"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo20;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo20;" class="MsoListParagraphCxSpLast">
    given name
  </p>

<p class="MsoNormal"><a name="_398ffc20-d5ac-4092-843a-206c43bfdd3e" id="_398ffc20-d5ac-4092-843a-206c43bfdd3e"></a>Personal names in German-speaking Europe consist of one or several given names
(Vorname, plural Vornamen) and a surname (Nachname, Familienname). The Vorname
is usually gender-specific.</p>
<div><a name="_typical_name_patterns_3" id="_typical_name_patterns_3"></a><p class="h3Annex">C.13.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.28</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_816b0bff-9269-45d1-85ef-31beed55a709" id="_816b0bff-9269-45d1-85ef-31beed55a709"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div>
</div>
<div><a name="_examples_3" id="_examples_3"></a><p class="h3Annex">C.13.2 Examples</p><div class="example"><a name="_eb4da485-aed3-49b0-b10b-0f854521157f" id="_eb4da485-aed3-49b0-b10b-0f854521157f"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Otto Eduard Leopold F&#xFC;rst von Bismarck.</p></div>
<p class="MsoNormal"><a name="_09c500fb-0204-4829-939f-c94492f5d2e1" id="_09c500fb-0204-4829-939f-c94492f5d2e1"></a>The Vorname (in English forename) is usually given to a child by the parents
shortly after birth. It is common to give a child several Vornamen (forenames).</p>
<p class="MsoNormal"><a name="_d9bbc385-7c2c-4a13-8a8e-ef24366e211d" id="_d9bbc385-7c2c-4a13-8a8e-ef24366e211d"></a>The Rufname (&#x201C;appellation name&#x201D; or &#x201C;call name&#x201D;) is the given name
intended for everyday use, and is often underlined on official documents.</p>
<div class="example"><a name="_917f37dd-dbb1-4ed0-af5c-422192256eea" id="_917f37dd-dbb1-4ed0-af5c-422192256eea"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>The Rufname of the mathematician Amalie Emmy Noether is &#x201C;Emmy&#x201D;.</p></div></div></div>
        <div><a name="_greek" id="_greek"></a><p class="h2Annex">C.14 Greek</p>

</div>
        <div><a name="_hindu" id="_hindu"></a><p class="h2Annex">C.15 Hindu</p>

</div>
        <div><a name="_hungarian" id="_hungarian"></a><p class="h2Annex">C.16 Hungarian</p><p class="MsoNormal"><a name="_a1b8ddd7-9f95-4a89-958f-92972a700730" id="_a1b8ddd7-9f95-4a89-958f-92972a700730"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo21;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo21;" class="MsoListParagraphCxSpLast">
    family name
  </p>

<div><a name="_typical_name_patterns_4" id="_typical_name_patterns_4"></a><p class="h3Annex">C.16.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.29</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_d08fa48e-e746-45c3-b04a-af90b412b801" id="_d08fa48e-e746-45c3-b04a-af90b412b801"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td></tr></tbody></table></div>
</div>
<div><a name="_examples_4" id="_examples_4"></a><p class="h3Annex">C.16.2 Examples</p><div class="example"><a name="_c051d171-5084-423f-9bee-dcaf28a208e7" id="_c051d171-5084-423f-9bee-dcaf28a208e7"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Kova&#x301;cs Ja&#x301;nos</p></div>
<div class="example"><a name="_6f26b940-8e3a-4ae8-8a75-2dbdb1f48746" id="_6f26b940-8e3a-4ae8-8a75-2dbdb1f48746"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>If there is more than one given name, they come in order of importance
after the family name:</p>
  <p style="mso-list:l3 level1 lfo22;" class="MsoListParagraphCxSpFirst">
    Kova&#x301;cs Ja&#x301;nos Alada&#x301;r
  </p>
</div>
<div class="example"><a name="_9f1d94d2-9800-4c51-a9b9-9bbd37a782b2" id="_9f1d94d2-9800-4c51-a9b9-9bbd37a782b2"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>There can be more than one family name, which can be written fully or abbreviated
into initials:</p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpFirst">
    Segesdy Kova&#x301;cs Ja&#x301;nos
  </p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpMiddle">
    Segesdy-Kova&#x301;cs Ja&#x301;nos
  </p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpMiddle">
    S.Kova&#x301;cs Ja&#x301;nos
  </p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpLast">
    Segesdy K. Ja&#x301;nos
  </p>
</div></div></div>
        <div><a name="_icelandic" id="_icelandic"></a><p class="h2Annex">C.17 Icelandic</p><p class="MsoNormal"><a name="_cc1326c9-a042-499a-8717-3c943b694fe2" id="_cc1326c9-a042-499a-8717-3c943b694fe2"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpMiddle">
    patronymic name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpMiddle">
    matronymic name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpMiddle">
    genonymic name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpLast">
    family name
  </p>

<p class="MsoNormal"><a name="_bebbecd5-f70c-4861-b079-bf430179a634" id="_bebbecd5-f70c-4861-b079-bf430179a634"></a>Icelandic names differ from most current Western family name systems by being
patronymic or occasionally matronymic: they indicate the father (or mother) of
the child and not the historic family lineage.</p>
<p class="MsoNormal"><a name="_ea300bba-60aa-49ab-aa81-6c0abbe22aa6" id="_ea300bba-60aa-49ab-aa81-6c0abbe22aa6"></a>Iceland&#x2019;s traditional name system was formerly used by all Nordic countries
except partly Finland.</p>
<p class="MsoNormal"><a name="_1b9c3b6e-8ccf-4017-be65-a5eebd35f641" id="_1b9c3b6e-8ccf-4017-be65-a5eebd35f641"></a>The Icelandic system is not based on family names
(although some people do have family names and might use both systems).
Generally, a person&#x2019;s second name indicates the first name of their father
(patronymic) or in some cases mother (matronymic). According to Icelandic
naming tradition, second names end in -son or -d&#xF3;ttir with few exceptions.</p>
<div><a name="_typical_name_patterns_5" id="_typical_name_patterns_5"></a><p class="h3Annex">C.17.1 Typical name patterns</p><p class="TableTitle" align="center">Table C.30</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_42919f27-0f5a-4931-bd94-108179365361" id="_42919f27-0f5a-4931-bd94-108179365361"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">patronymic or matronymic name</td></tr></tbody></table></div>
<p class="TableTitle" align="center">Table C.31</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_8d24096e-3d77-4807-bdf7-89a9806ab2e3" id="_8d24096e-3d77-4807-bdf7-89a9806ab2e3"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">patronymic or matronymic name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">genonymic name</td></tr></tbody></table></div>
<p class="TableTitle" align="center">Table C.32</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_a9cefca3-e1ff-4cf9-9e5a-2edace646eb9" id="_a9cefca3-e1ff-4cf9-9e5a-2edace646eb9"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">patronymic or matronymic name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">(genonymic name)</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div></div>
<div><a name="_examples_5" id="_examples_5"></a><p class="h3Annex">C.17.2 Examples</p><div class="example"><a name="_053644ff-9f0e-4f50-8772-ce71460e43cf" id="_053644ff-9f0e-4f50-8772-ce71460e43cf"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>J&#xF3;hanna Sigur&#xF0;ard&#xF3;ttir. &#x201C;J&#xF3;hanna, daughter of Sigur&#xF0;ur&#x201D;.</p></div>
<div class="example"><a name="_974b521b-f096-49f5-bb00-4708f34fac97" id="_974b521b-f096-49f5-bb00-4708f34fac97"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Matronymic. Hei&#xF0;ar Helguson, &#x201C;Helguson, son of Helga&#x201D;.</p></div>
<div class="example"><a name="_7e11244b-f093-416e-95bf-03704c390a31" id="_7e11244b-f093-416e-95bf-03704c390a31"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>&#xD6;rvar &#xDE;&#xF3;reyjarson Sm&#xE1;rason. (&#xD6;rvar, son of &#xDE;&#xF3;rey, son of Sm&#xE1;ri)</p></div>
<p class="MsoNormal"><a name="_4acc2c90-c70d-4423-b715-9814626f50c4" id="_4acc2c90-c70d-4423-b715-9814626f50c4"></a>Some family names do exist in Iceland, most commonly adaptations from last name
patronyms Icelanders took up when living abroad.</p>
<div class="example"><a name="_91496901-a22e-47c0-af2a-70206109c899" id="_91496901-a22e-47c0-af2a-70206109c899"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  4</span><span style="mso-tab-count:1">&#xA0; </span>Geir Haarde, Ei&#xF0;ur Sm&#xE1;ri Gu&#xF0;johnsen, Anita Briem.</p></div>
<div class="example"><a name="_d10ad8ac-1622-4fa3-ba45-712e22824ed7" id="_d10ad8ac-1622-4fa3-ba45-712e22824ed7"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  5</span><span style="mso-tab-count:1">&#xA0; </span>Nobel Prize-winning author Halld&#xF3;r Laxness, born as Halld&#xF3;r Gu&#xF0;j&#xF3;nsson.</p></div></div></div>
        <div><a name="_indian" id="_indian"></a><p class="h2Annex">C.18 Indian</p>

</div>
        <div><a name="_indonesian" id="_indonesian"></a><p class="h2Annex">C.19 Indonesian</p><p class="MsoNormal"><a name="_2936d9d1-81e7-4c28-8cf8-0fddc0d6c2df" id="_2936d9d1-81e7-4c28-8cf8-0fddc0d6c2df"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo25;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo25;" class="MsoListParagraphCxSpMiddle">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo25;" class="MsoListParagraphCxSpLast">
    patronymic name
  </p>

<p class="MsoNormal"><a name="_559f3a6b-91f7-4b55-a95a-a0f88edfb70a" id="_559f3a6b-91f7-4b55-a95a-a0f88edfb70a"></a>Indonesians generally use given names without a family name.
The majority of Indonesians do not have family names. Rather,
their given names are geographically and culturally specific.</p>
<p class="MsoNormal"><a name="_da221e3d-23f5-451e-9be6-93ae1f2bb810" id="_da221e3d-23f5-451e-9be6-93ae1f2bb810"></a>Some given names include a family name or a patronymic.</p>
<div><a name="_typical_name_patterns_6" id="_typical_name_patterns_6"></a><p class="h3Annex">C.19.1 Typical name patterns</p><p class="MsoNormal"><a name="_094c714a-f126-4b1e-ae61-58ce940e6ec6" id="_094c714a-f126-4b1e-ae61-58ce940e6ec6"></a>Indonesian names usually fall into one of the following categories:</p>

  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpFirst">
    Mononymic names
  </p>
  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpMiddle">
    Polynymic names without a family name
  </p>
  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpMiddle">
    Polynymic names with a family name
  </p>
  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpLast">
    Polynymic names with patronymic
  </p>

<p class="MsoNormal"><a name="_042b7922-92b1-4742-bef0-a37573e19569" id="_042b7922-92b1-4742-bef0-a37573e19569"></a>An Indonesian name is often mis-represented in other cultures, such as:</p>

  <p style="mso-list:l3 level1 lfo27;" class="MsoListParagraphCxSpFirst">
    Netherlands: the word &#x201C;Onbekend&#x201D; (&#x201C;unknown&#x201D;) is assigned as a last name
  </p>
  <p style="mso-list:l3 level1 lfo27;" class="MsoListParagraphCxSpMiddle">
    Germany: the one-word name is used as both given name and surname
  </p>
  <p style="mso-list:l3 level1 lfo27;" class="MsoListParagraphCxSpLast">
    US: &#x201C;Fnu&#x201D; (family name unknown) is assigned as the first or given name, &#x201C;Lnu&#x201D; (last name unknown) is assigned as the family, surname or last name,
or the name is duplicated as the surname.
  </p>
</div>
<div><a name="_examples_6" id="_examples_6"></a><p class="h3Annex">C.19.2 Examples</p><div class="example"><a name="_7e1ff203-e305-4eb1-b6bb-0a549e34beeb" id="_7e1ff203-e305-4eb1-b6bb-0a549e34beeb"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>&#x201C;Mulyono&#x201D;, the original name of &#x201C;Joko Widodo&#x201D;</p></div>
<div class="example"><a name="_a9464bd9-cef1-4ae3-8a35-0a7c9e422f09" id="_a9464bd9-cef1-4ae3-8a35-0a7c9e422f09"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Kusno Sosrodihardjo</p></div>
<div class="example"><a name="_02dec097-deeb-4646-b1ce-5df758b9f3bf" id="_02dec097-deeb-4646-b1ce-5df758b9f3bf"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>Fransiskus Xaverius Hadi Rudyatmo</p></div>
<div class="example"><a name="_620d0844-0cfa-4e3c-8084-c2b2224e7668" id="_620d0844-0cfa-4e3c-8084-c2b2224e7668"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  4</span><span style="mso-tab-count:1">&#xA0; </span>Sudono Salim</p></div></div></div>
        <div><a name="_iranian" id="_iranian"></a><p class="h2Annex">C.20 Iranian</p>

</div>
        <div><a name="_iraqi" id="_iraqi"></a><p class="h2Annex">C.21 Iraqi</p>

</div>
        <div><a name="_italian" id="_italian"></a><p class="h2Annex">C.22 Italian</p><p class="MsoNormal"><a name="_4c4bce48-1c56-45ea-981d-4dedbf0a19f2" id="_4c4bce48-1c56-45ea-981d-4dedbf0a19f2"></a>A name in Italian consists of a given name (nome) and a surname (cognome).
Surnames are normally written after given names.</p>
<p class="MsoNormal"><a name="_9905a5f7-eabe-424f-a9f7-c70e8ec027a3" id="_9905a5f7-eabe-424f-a9f7-c70e8ec027a3"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo28;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo28;" class="MsoListParagraphCxSpLast">
    given name
  </p>
</div>
        <div><a name="_japanese" id="_japanese"></a><p class="h2Annex">C.23 Japanese</p><p class="MsoNormal"><a name="_979bcba3-fab2-49dd-a4b6-a0fb06dafae5" id="_979bcba3-fab2-49dd-a4b6-a0fb06dafae5"></a>Japanese names usually consist of a family name (surname),
followed by a given name.</p>
<p class="MsoNormal"><a name="_b66bb4ec-b025-4cda-aba1-f56316a0bede" id="_b66bb4ec-b025-4cda-aba1-f56316a0bede"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo29;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo29;" class="MsoListParagraphCxSpLast">
    given name
  </p>

<p class="MsoNormal"><a name="_9d93567d-4cf4-4044-a7fb-054b8aa3178f" id="_9d93567d-4cf4-4044-a7fb-054b8aa3178f"></a>Japanese names are usually written in kanji,
where characters are logographic, but each with a variety of
possible Japanese pronunciations.
Therefore, names often cannot be spelled or pronounced
unless both the spelling and pronunciation are given.</p>
<div><a name="_typical_name_patterns_7" id="_typical_name_patterns_7"></a><p class="h3Annex">C.23.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.33</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_f58e1980-1c2e-4c2f-a688-a318ead534c4" id="_f58e1980-1c2e-4c2f-a688-a318ead534c4"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td></tr></tbody></table></div>
</div>
<div><a name="_examples_7" id="_examples_7"></a><p class="h3Annex">C.23.2 Examples</p><div class="example"><a name="_f16abb3c-7313-4582-887d-ce79389cb8ad" id="_f16abb3c-7313-4582-887d-ce79389cb8ad"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>&#x5927;&#x7FD4; is traditionally pronounced &#x201C;Hiroto&#x201D;, but can also be pronounced as
&#x201C;Haruto&#x201D;, &#x201C;Yamato&#x201D;, &#x201C;Taiga&#x201D;, &#x201C;Sora&#x201D;, &#x201C;Taito&#x201D;, &#x201C;Daito&#x201D;, and
&#x201C;Masato&#x201D;.</p></div>
<div class="example"><a name="_98908c4f-b699-4569-b97e-399debd1531f" id="_98908c4f-b699-4569-b97e-399debd1531f"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>&#x5927;&#x548C; can be read as Daiwa or Yamato.</p></div>
<div class="example"><a name="_ba8513c7-ac61-479f-b11b-6f8101959837" id="_ba8513c7-ac61-479f-b11b-6f8101959837"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>&#x6771;&#x6D77;&#x6797; can be read as T&#x14D;kairin or Sh&#x14D;ji.</p></div>
