      <div class="Section3"><a name="AnnexA" id="AnnexA"></a>
        <h1 class="Annex"><b>Annex B</b><br/>(normative)<br/><br/><b>Honorific types</b></h1>
        <div><a name="_general_7" id="_general_7"></a><p class="h2Annex">B.1 General</p><div><a name="_mister" id="_mister"></a><p class="h3Annex">B.1.1 Mister</p><table class="dl"><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Code</p></td><td valign="top">
    <p class="MsoNormal"><a name="_3d7433b4-93c0-4aa5-9125-88da25f78029" id="_3d7433b4-93c0-4aa5-9125-88da25f78029"></a>urn:iso:name:honorific:general:mr</p>
  </td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Description</p></td><td valign="top">
    <p class="MsoNormal"><a name="_40e38648-d2ad-411c-ade0-7ecd7b531ab9" id="_40e38648-d2ad-411c-ade0-7ecd7b531ab9"></a>commonly used English honorific for men</p>
  </td></tr></table>
<div class="example"><a name="_e6063b02-1230-4537-b53c-09b60869ff2c" id="_e6063b02-1230-4537-b53c-09b60869ff2c"></a><p class="example"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Mr. Smith</p></div>
<div class="example"><a name="_9c9503ea-317d-48ed-82b8-555177effbeb" id="_9c9503ea-317d-48ed-82b8-555177effbeb"></a><p class="example"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Mr Smith</p></div>
<p class="TableTitle" style="text-align:center;">Table B.1</p><div align="center"><table class="MsoISOTable" style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;border-spacing:0;border-width:1px;" summary=""><a name="_8a4f4a78-94a7-490b-8d02-a049e613d37b" id="_8a4f4a78-94a7-490b-8d02-a049e613d37b"></a><thead><tr><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Language</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Abbreviations</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Rendered</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Position</th></tr></thead><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">en</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Mr, Mr.</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Mr</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Prefix</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">fr</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">M., Mssr.</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Monsieur</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Prefix</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">de</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;"></td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Herr</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Prefix</td></tr></tbody></table></div></div>
<div><a name="_mrs" id="_mrs"></a><p class="h3Annex">B.1.2 Mrs</p><table class="dl"><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Code</p></td><td valign="top">
    <p class="MsoNormal"><a name="_f2531652-e610-410a-add4-8d22dfa645bc" id="_f2531652-e610-410a-add4-8d22dfa645bc"></a>urn:iso:name:honorific:general:mrs</p>
  </td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Description</p></td><td valign="top">
    <p class="MsoNormal"><a name="_79ddd6d5-9a51-40fc-8cd6-5d777e98cf45" id="_79ddd6d5-9a51-40fc-8cd6-5d777e98cf45"></a>commonly used English honorific for women. Originated from &#x201C;Mistress&#x201D;.</p>
  </td></tr></table>
