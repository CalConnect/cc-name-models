        <br clear="all" style="mso-special-character:line-break;page-break-before:always"/>
      </p>
      <div class="Section3"><a name="AnnexA" id="AnnexA"></a>
        <h1 class="Annex"><b>Annex B</b><br/>(normative)<br/><br/><b>Honorific types</b></h1>
        <div><a name="_general_7" id="_general_7"></a><p class="h2Annex">B.1 General</p><div><a name="_mister" id="_mister"></a><p class="h3Annex">B.1.1 Mister</p><table class="dl"><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Code</p></td><td valign="top">
    <p class="MsoNormal"><a name="_f3609bdc-e669-41ed-9f95-172ce6d11b46" id="_f3609bdc-e669-41ed-9f95-172ce6d11b46"></a>urn:iso:name:honorific:general:mr</p>
  </td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Description</p></td><td valign="top">
    <p class="MsoNormal"><a name="_78a8c1e2-1806-422e-889b-0c6d315b06f2" id="_78a8c1e2-1806-422e-889b-0c6d315b06f2"></a>commonly used English honorific for men</p>
  </td></tr></table>
<div class="example"><a name="_0ff2b93d-3d07-4f46-b05a-ed91dd18061b" id="_0ff2b93d-3d07-4f46-b05a-ed91dd18061b"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Mr. Smith</p></div>
<div class="example"><a name="_b44f04a5-be69-440c-a58a-038cbe1ecc07" id="_b44f04a5-be69-440c-a58a-038cbe1ecc07"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Mr Smith</p></div>
<p class="TableTitle" align="center">Table B.1</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_1e82dee9-c3e3-4e16-be90-784b128f40b6" id="_1e82dee9-c3e3-4e16-be90-784b128f40b6"></a><thead><tr><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Language</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Abbreviations</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Rendered</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Position</th></tr></thead><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">en</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Mr, Mr.</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Mr</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Prefix</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">fr</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">M., Mssr.</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Monsieur</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Prefix</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">de</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;"></td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Herr</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Prefix</td></tr></tbody></table></div></div>
<div><a name="_mrs" id="_mrs"></a><p class="h3Annex">B.1.2 Mrs</p><table class="dl"><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Code</p></td><td valign="top">
    <p class="MsoNormal"><a name="_fe3ca9f8-9f88-473f-acde-02dd3cb75eab" id="_fe3ca9f8-9f88-473f-acde-02dd3cb75eab"></a>urn:iso:name:honorific:general:mrs</p>
  </td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Description</p></td><td valign="top">
    <p class="MsoNormal"><a name="_2646719b-69c6-43b8-900f-5d6f4532debf" id="_2646719b-69c6-43b8-900f-5d6f4532debf"></a>commonly used English honorific for women. Originated from &#x201C;Mistress&#x201D;.</p>
  </td></tr></table>
