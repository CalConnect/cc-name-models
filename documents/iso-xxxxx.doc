b7-ab8b-bd9d3683f24d" id="_01e8c149-ec4c-41b7-ab8b-bd9d3683f24d"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x912D;</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x91AB;&#x751F;</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">title</td></tr></tbody></table></div><p class="TableTitle" align="center">Table C.23</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_05b34f1f-40ec-4ac5-9c9f-39ba268c6db9" id="_05b34f1f-40ec-4ac5-9c9f-39ba268c6db9"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x963F;</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x738B;</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;"></td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div></div></div></div>
        <div><a name="_colombian" id="_colombian"></a><p class="h2Annex">C.9 Colombian</p>

</div>
        <div><a name="_czech" id="_czech"></a><p class="h2Annex">C.10 Czech</p>

</div>
        <div><a name="_english" id="_english"></a><p class="h2Annex">C.11 English</p><p class="MsoNormal"><a name="_8c80816a-4fe1-4a0a-ad60-66042bb202db" id="_8c80816a-4fe1-4a0a-ad60-66042bb202db"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo18;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo18;" class="MsoListParagraphCxSpLast">
    family name
  </p>

<p class="MsoNormal"><a name="_eef05991-3984-4fac-9a29-fe3f3b15450b" id="_eef05991-3984-4fac-9a29-fe3f3b15450b"></a>English names are names used in, or originating in, England. In England as
elsewhere in the English-speaking world, a complete name usually consists of a
given name, commonly referred to as a first name or Christian name, and a (most
commonly patrilineal) family name or surname, also referred to as a last name.</p>
<p class="MsoNormal"><a name="_167b6f7c-823d-42af-a322-ac682d4a9144" id="_167b6f7c-823d-42af-a322-ac682d4a9144"></a>There can be several given names, some of these being often referred to as a
second name, or middle name(s).</p>
<p class="MsoNormal"><a name="_d3fc5b5b-35ce-4079-905d-718b9c4250b3" id="_d3fc5b5b-35ce-4079-905d-718b9c4250b3"></a>Double-barrelled names, compound surnames in English feature two words,
are often joined by a hyphen or hyphens.</p>
<div><a name="_typical_name_patterns" id="_typical_name_patterns"></a><p class="h3Annex">C.11.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.24</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_1d1c16a1-28da-492c-9928-84cb9457f8b6" id="_1d1c16a1-28da-492c-9928-84cb9457f8b6"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div>
</div>
<div><a name="_examples" id="_examples"></a><p class="h3Annex">C.11.2 Examples</p><div class="example"><a name="_4015ff70-4059-4a57-aec3-3248f9b8c802" id="_4015ff70-4059-4a57-aec3-3248f9b8c802"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Henry Hepburne-Scott</p></div>
<p class="MsoNormal"><a name="_505af686-0abf-4515-8d7f-7867debed8e7" id="_505af686-0abf-4515-8d7f-7867debed8e7"></a>Some families having as many as
three or four words making up their surname.</p>
<div class="example"><a name="_8ca2eeb3-9bf3-4686-b7e9-e047ba5dc141" id="_8ca2eeb3-9bf3-4686-b7e9-e047ba5dc141"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Charles Hepburn-Stuart-Forbes-Trefusis, 21st Baron Clinton.</p></div>
<p class="MsoNormal"><a name="_ae78bffa-f39b-4cd2-8495-327773cb3ccc" id="_ae78bffa-f39b-4cd2-8495-327773cb3ccc"></a>It is not unusual for compound surnames to be composed of separate words
not linked by a hyphen.</p>
<div class="example"><a name="_041af470-9cb7-435e-a4cd-f8ab6759e91d" id="_041af470-9cb7-435e-a4cd-f8ab6759e91d"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span></p>
  <p class="TableTitle" align="center">Table C.25</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_a7d807c0-d427-4b84-ab22-25e5c9d41390" id="_a7d807c0-d427-4b84-ab22-25e5c9d41390"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Iain</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Duncan Smith</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div>
</div></div></div>
        <div><a name="_french" id="_french"></a><p class="h2Annex">C.12 French</p><p class="MsoNormal"><a name="_99116246-6e82-470c-b152-a84ea7390342" id="_99116246-6e82-470c-b152-a84ea7390342"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo19;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo19;" class="MsoListParagraphCxSpLast">
    given name
  </p>

<p class="MsoNormal"><a name="_27f683ba-5432-4e86-bf2d-c76bdfdeabe7" id="_27f683ba-5432-4e86-bf2d-c76bdfdeabe7"></a>French people have one, two or more given names (first names). One of them
is used in daily life.</p>
<div><a name="_typical_name_patterns_2" id="_typical_name_patterns_2"></a><p class="h3Annex">C.12.1 Typical name patterns</p><p class="TableTitle" align="center">Table C.26</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_75d75e3d-57ca-4abe-9ca5-6aa0405a41e4" id="_75d75e3d-57ca-4abe-9ca5-6aa0405a41e4"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td></tr></tbody></table></div>
<p class="TableTitle" align="center">Table C.27</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_91ed94b3-93c0-4c77-aa3a-3e636851e729" id="_91ed94b3-93c0-4c77-aa3a-3e636851e729"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div></div>
<div><a name="_examples_2" id="_examples_2"></a><p class="h3Annex">C.12.2 Examples</p><div class="example"><a name="_1132933a-137c-4944-9cc9-2f9d7c16d325" id="_1132933a-137c-4944-9cc9-2f9d7c16d325"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>&#x201C;Jacques Chirac&#x201D; instead of officially of Jacques Ren&#xE9; Chirac.</p></div>
<div class="example"><a name="_8e840a33-edad-46f8-b749-f47e9d959c62" id="_8e840a33-edad-46f8-b749-f47e9d959c62"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>&#x201C;Philippe P&#xE9;tain&#x201D; instead of officially of Henri Philippe P&#xE9;tain,
because Philippe was the given name that he used in daily
life.</p></div>
<p class="MsoNormal"><a name="_dc7d677a-d3ad-4e25-9fe2-aa3c00c89fe6" id="_dc7d677a-d3ad-4e25-9fe2-aa3c00c89fe6"></a>Middle names in the English sense do not exist, and middle initials are
never used for second or further given names.</p>
<div class="example"><a name="_78c1360c-3948-4891-9102-9384d60224c2" id="_78c1360c-3948-4891-9102-9384d60224c2"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>Claude All&#xE8;gre may be cited as &#x201C;Claude J. All&#xE8;gre&#x201D; in English-speaking
scientific publications, but not in French ones.</p></div></div></div>
        <div><a name="_german" id="_german"></a><p class="h2Annex">C.13 German</p><p class="MsoNormal"><a name="_3f9eb924-ce0c-405b-a8e8-b4a4c2945351" id="_3f9eb924-ce0c-405b-a8e8-b4a4c2945351"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo20;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo20;" class="MsoListParagraphCxSpLast">
    given name
  </p>

<p class="MsoNormal"><a name="_e57b8a61-cf1c-49d9-8f76-20cd4ac6d815" id="_e57b8a61-cf1c-49d9-8f76-20cd4ac6d815"></a>Personal names in German-speaking Europe consist of one or several given names
(Vorname, plural Vornamen) and a surname (Nachname, Familienname). The Vorname
is usually gender-specific.</p>
<div><a name="_typical_name_patterns_3" id="_typical_name_patterns_3"></a><p class="h3Annex">C.13.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.28</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_0e729656-4fdf-44f2-8e5f-21b266fefa6d" id="_0e729656-4fdf-44f2-8e5f-21b266fefa6d"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div>
</div>
<div><a name="_examples_3" id="_examples_3"></a><p class="h3Annex">C.13.2 Examples</p><div class="example"><a name="_197c488a-7203-40d1-b5a4-4fee64eaf8c9" id="_197c488a-7203-40d1-b5a4-4fee64eaf8c9"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Otto Eduard Leopold F&#xFC;rst von Bismarck.</p></div>
<p class="MsoNormal"><a name="_a54f299c-a1c8-4255-8c83-7af0e6d2ec52" id="_a54f299c-a1c8-4255-8c83-7af0e6d2ec52"></a>The Vorname (in English forename) is usually given to a child by the parents
shortly after birth. It is common to give a child several Vornamen (forenames).</p>
<p class="MsoNormal"><a name="_2ef63062-e69b-43c0-8d4d-9eb02c13345f" id="_2ef63062-e69b-43c0-8d4d-9eb02c13345f"></a>The Rufname (&#x201C;appellation name&#x201D; or &#x201C;call name&#x201D;) is the given name
intended for everyday use, and is often underlined on official documents.</p>
<div class="example"><a name="_13f3988f-cfec-443c-af40-108b80c5fb50" id="_13f3988f-cfec-443c-af40-108b80c5fb50"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>The Rufname of the mathematician Amalie Emmy Noether is &#x201C;Emmy&#x201D;.</p></div></div></div>
        <div><a name="_greek" id="_greek"></a><p class="h2Annex">C.14 Greek</p>

</div>
        <div><a name="_hindu" id="_hindu"></a><p class="h2Annex">C.15 Hindu</p>

</div>
        <div><a name="_hungarian" id="_hungarian"></a><p class="h2Annex">C.16 Hungarian</p><p class="MsoNormal"><a name="_9e9f367f-7d74-4ea5-bdab-8548e40bdf41" id="_9e9f367f-7d74-4ea5-bdab-8548e40bdf41"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo21;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo21;" class="MsoListParagraphCxSpLast">
    family name
  </p>

<div><a name="_typical_name_patterns_4" id="_typical_name_patterns_4"></a><p class="h3Annex">C.16.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.29</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_4c521c87-d32a-481f-a9d6-8d78aeaaa1df" id="_4c521c87-d32a-481f-a9d6-8d78aeaaa1df"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td></tr></tbody></table></div>
</div>
<div><a name="_examples_4" id="_examples_4"></a><p class="h3Annex">C.16.2 Examples</p><div class="example"><a name="_6a7ff4f0-22ec-4530-89cb-231f557ef4b0" id="_6a7ff4f0-22ec-4530-89cb-231f557ef4b0"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Kova&#x301;cs Ja&#x301;nos</p></div>
<div class="example"><a name="_c10c9592-bd5f-437b-9cff-c6910dbef8b2" id="_c10c9592-bd5f-437b-9cff-c6910dbef8b2"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>If there is more than one given name, they come in order of importance
after the family name:</p>
  <p style="mso-list:l3 level1 lfo22;" class="MsoListParagraphCxSpFirst">
    Kova&#x301;cs Ja&#x301;nos Alada&#x301;r
  </p>
</div>
<div class="example"><a name="_58729858-824c-4f22-aa8e-9c474418bb21" id="_58729858-824c-4f22-aa8e-9c474418bb21"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>There can be more than one family name, which can be written fully or abbreviated
into initials:</p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpFirst">
    Segesdy Kova&#x301;cs Ja&#x301;nos
  </p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpMiddle">
    Segesdy-Kova&#x301;cs Ja&#x301;nos
  </p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpMiddle">
    S.Kova&#x301;cs Ja&#x301;nos
  </p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpLast">
    Segesdy K. Ja&#x301;nos
  </p>
</div></div></div>
        <div><a name="_icelandic" id="_icelandic"></a><p class="h2Annex">C.17 Icelandic</p><p class="MsoNormal"><a name="_80eb5208-a226-4dae-8696-cde9292dc232" id="_80eb5208-a226-4dae-8696-cde9292dc232"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpMiddle">
    patronymic name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpMiddle">
    matronymic name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpMiddle">
    genonymic name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpLast">
    family name
  </p>

<p class="MsoNormal"><a name="_06ce545f-e85a-4bcf-a382-503e42834bc7" id="_06ce545f-e85a-4bcf-a382-503e42834bc7"></a>Icelandic names differ from most current Western family name systems by being
patronymic or occasionally matronymic: they indicate the father (or mother) of
the child and not the historic family lineage.</p>
<p class="MsoNormal"><a name="_17db5ff7-8565-4a01-8152-b5d7a5152767" id="_17db5ff7-8565-4a01-8152-b5d7a5152767"></a>Iceland&#x2019;s traditional name system was formerly used by all Nordic countries
except partly Finland.</p>
<p class="MsoNormal"><a name="_e0db6c5c-1902-48df-8ebb-ddaaf21ce2f3" id="_e0db6c5c-1902-48df-8ebb-ddaaf21ce2f3"></a>The Icelandic system is not based on family names
(although some people do have family names and might use both systems).
Generally, a person&#x2019;s second name indicates the first name of their father
(patronymic) or in some cases mother (matronymic). According to Icelandic
naming tradition, second names end in -son or -d&#xF3;ttir with few exceptions.</p>
<div><a name="_typical_name_patterns_5" id="_typical_name_patterns_5"></a><p class="h3Annex">C.17.1 Typical name patterns</p><p class="TableTitle" align="center">Table C.30</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_6da622bb-7357-4344-9e1c-d3d6c85736d9" id="_6da622bb-7357-4344-9e1c-d3d6c85736d9"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">patronymic or matronymic name</td></tr></tbody></table></div>
<p class="TableTitle" align="center">Table C.31</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_dbf728bb-db21-4d4b-8830-607d6c2b3479" id="_dbf728bb-db21-4d4b-8830-607d6c2b3479"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">patronymic or matronymic name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">genonymic name</td></tr></tbody></table></div>
<p class="TableTitle" align="center">Table C.32</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_7e6ea031-9f1a-4e50-ade9-27b5cafd5cb5" id="_7e6ea031-9f1a-4e50-ade9-27b5cafd5cb5"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">patronymic or matronymic name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">(genonymic name)</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div></div>
<div><a name="_examples_5" id="_examples_5"></a><p class="h3Annex">C.17.2 Examples</p><div class="example"><a name="_f3dfda48-b649-412e-bb78-fd5b7c00cee1" id="_f3dfda48-b649-412e-bb78-fd5b7c00cee1"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>J&#xF3;hanna Sigur&#xF0;ard&#xF3;ttir. &#x201C;J&#xF3;hanna, daughter of Sigur&#xF0;ur&#x201D;.</p></div>
<div class="example"><a name="_e12ec943-4bfe-4f04-b828-1f11bb3c9c54" id="_e12ec943-4bfe-4f04-b828-1f11bb3c9c54"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Matronymic. Hei&#xF0;ar Helguson, &#x201C;Helguson, son of Helga&#x201D;.</p></div>
<div class="example"><a name="_66e5651b-342e-46ef-850b-f4d811ed27d2" id="_66e5651b-342e-46ef-850b-f4d811ed27d2"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>&#xD6;rvar &#xDE;&#xF3;reyjarson Sm&#xE1;rason. (&#xD6;rvar, son of &#xDE;&#xF3;rey, son of Sm&#xE1;ri)</p></div>
<p class="MsoNormal"><a name="_3cbea4e4-34b1-41c7-ad88-5940edf2d566" id="_3cbea4e4-34b1-41c7-ad88-5940edf2d566"></a>Some family names do exist in Iceland, most commonly adaptations from last name
patronyms Icelanders took up when living abroad.</p>
<div class="example"><a name="_15160dd4-9b81-42bc-ad2a-56aa0278bf26" id="_15160dd4-9b81-42bc-ad2a-56aa0278bf26"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  4</span><span style="mso-tab-count:1">&#xA0; </span>Geir Haarde, Ei&#xF0;ur Sm&#xE1;ri Gu&#xF0;johnsen, Anita Briem.</p></div>
<div class="example"><a name="_94820a0b-2eb5-401d-aa18-5f299cae0ba2" id="_94820a0b-2eb5-401d-aa18-5f299cae0ba2"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  5</span><span style="mso-tab-count:1">&#xA0; </span>Nobel Prize-winning author Halld&#xF3;r Laxness, born as Halld&#xF3;r Gu&#xF0;j&#xF3;nsson.</p></div></div></div>
        <div><a name="_indian" id="_indian"></a><p class="h2Annex">C.18 Indian</p>

</div>
        <div><a name="_indonesian" id="_indonesian"></a><p class="h2Annex">C.19 Indonesian</p><p class="MsoNormal"><a name="_da5b2745-fcfb-4de6-9246-e6b264d4bac8" id="_da5b2745-fcfb-4de6-9246-e6b264d4bac8"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo25;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo25;" class="MsoListParagraphCxSpMiddle">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo25;" class="MsoListParagraphCxSpLast">
    patronymic name
  </p>

<p class="MsoNormal"><a name="_cf2fd9a9-7040-4d57-8f72-5b341c85563b" id="_cf2fd9a9-7040-4d57-8f72-5b341c85563b"></a>Indonesians generally use given names without a family name.
The majority of Indonesians do not have family names. Rather,
their given names are geographically and culturally specific.</p>
<p class="MsoNormal"><a name="_899e2f9c-ad8e-4192-acaa-70c04d883feb" id="_899e2f9c-ad8e-4192-acaa-70c04d883feb"></a>Some given names include a family name or a patronymic.</p>
<div><a name="_typical_name_patterns_6" id="_typical_name_patterns_6"></a><p class="h3Annex">C.19.1 Typical name patterns</p><p class="MsoNormal"><a name="_a8c96b43-9aac-43d5-ba18-89c1d83ec704" id="_a8c96b43-9aac-43d5-ba18-89c1d83ec704"></a>Indonesian names usually fall into one of the following categories:</p>

  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpFirst">
    Mononymic names
  </p>
  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpMiddle">
    Polynymic names without a family name
  </p>
  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpMiddle">
    Polynymic names with a family name
  </p>
  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpLast">
    Polynymic names with patronymic
  </p>

<p class="MsoNormal"><a name="_b2e98817-bea5-49ca-bb40-9bf87f491c47" id="_b2e98817-bea5-49ca-bb40-9bf87f491c47"></a>An Indonesian name is often mis-represented in other cultures, such as:</p>

  <p style="mso-list:l3 level1 lfo27;" class="MsoListParagraphCxSpFirst">
    Netherlands: the word &#x201C;Onbekend&#x201D; (&#x201C;unknown&#x201D;) is assigned as a last name
  </p>
  <p style="mso-list:l3 level1 lfo27;" class="MsoListParagraphCxSpMiddle">
    Germany: the one-word name is used as both given name and surname
  </p>
  <p style="mso-list:l3 level1 lfo27;" class="MsoListParagraphCxSpLast">
    US: &#x201C;Fnu&#x201D; (family name unknown) is assigned as the first or given name, &#x201C;Lnu&#x201D; (last name unknown) is assigned as the family, surname or last name,
or the name is duplicated as the surname.
  </p>
</div>
<div><a name="_examples_6" id="_examples_6"></a><p class="h3Annex">C.19.2 Examples</p><div class="example"><a name="_527c0d36-0923-4e37-a59f-b7b635adb169" id="_527c0d36-0923-4e37-a59f-b7b635adb169"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>&#x201C;Mulyono&#x201D;, the original name of &#x201C;Joko Widodo&#x201D;</p></div>
<div class="example"><a name="_2c0c5ff3-9aee-4040-a067-155d7d25a1c2" id="_2c0c5ff3-9aee-4040-a067-155d7d25a1c2"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Kusno Sosrodihardjo</p></div>
<div class="example"><a name="_15ef5315-3d67-4efe-9983-a7a31a733b30" id="_15ef5315-3d67-4efe-9983-a7a31a733b30"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>Fransiskus Xaverius Hadi Rudyatmo</p></div>
<div class="example"><a name="_52e7b86d-9f2a-45ea-a708-2f8e0bbed260" id="_52e7b86d-9f2a-45ea-a708-2f8e0bbed260"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  4</span><span style="mso-tab-count:1">&#xA0; </span>Sudono Salim</p></div></div></div>
        <div><a name="_iranian" id="_iranian"></a><p class="h2Annex">C.20 Iranian</p>

</div>
        <div><a name="_iraqi" id="_iraqi"></a><p class="h2Annex">C.21 Iraqi</p>

</div>
        <div><a name="_italian" id="_italian"></a><p class="h2Annex">C.22 Italian</p><p class="MsoNormal"><a name="_a5413964-b930-4c45-874a-31b2e2e7f608" id="_a5413964-b930-4c45-874a-31b2e2e7f608"></a>A name in Italian consists of a given name (nome) and a surname (cognome).
Surnames are normally written after given names.</p>
<p class="MsoNormal"><a name="_e98283cb-28a9-4779-9e76-c552fc982034" id="_e98283cb-28a9-4779-9e76-c552fc982034"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo28;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo28;" class="MsoListParagraphCxSpLast">
    given name
  </p>
</div>
        <div><a name="_japanese" id="_japanese"></a><p class="h2Annex">C.23 Japanese</p><p class="MsoNormal"><a name="_4fab5f38-f53a-4893-a053-4ea5acb30f20" id="_4fab5f38-f53a-4893-a053-4ea5acb30f20"></a>Japanese names usually consist of a family name (surname),
followed by a given name.</p>
<p class="MsoNormal"><a name="_9d22849b-4f64-43aa-8511-a4a28f347766" id="_9d22849b-4f64-43aa-8511-a4a28f347766"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo29;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo29;" class="MsoListParagraphCxSpLast">
    given name
  </p>

<p class="MsoNormal"><a name="_e0270e57-7f55-499f-be44-661702a02eb3" id="_e0270e57-7f55-499f-be44-661702a02eb3"></a>Japanese names are usually written in kanji,
where characters are logographic, but each with a variety of
possible Japanese pronunciations.
Therefore, names often cannot be spelled or pronounced
unless both the spelling and pronunciation are given.</p>
<div><a name="_typical_name_patterns_7" id="_typical_name_patterns_7"></a><p class="h3Annex">C.23.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.33</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_8210b1a9-f76f-478c-8a79-cade7da78766" id="_8210b1a9-f76f-478c-8a79-cade7da78766"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td></tr></tbody></table></div>
</div>
<div><a name="_examples_7" id="_examples_7"></a><p class="h3Annex">C.23.2 Examples</p><div class="example"><a name="_0d7febf4-0793-41da-bf0e-4eca5d7b9dd8" id="_0d7febf4-0793-41da-bf0e-4eca5d7b9dd8"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>&#x5927;&#x7FD4; is traditionally pronounced &#x201C;Hiroto&#x201D;, but can also be pronounced as
&#x201C;Haruto&#x201D;, &#x201C;Yamato&#x201D;, &#x201C;Taiga&#x201D;, &#x201C;Sora&#x201D;, &#x201C;Taito&#x201D;, &#x201C;Daito&#x201D;, and
&#x201C;Masato&#x201D;.</p></div>
<div class="example"><a name="_3ecc91e5-6673-4b84-9bbd-ab4aa7c7f252" id="_3ecc91e5-6673-4b84-9bbd-ab4aa7c7f252"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>&#x5927;&#x548C; can be read as Daiwa or Yamato.</p></div>
<div class="example"><a name="_f4b07a60-f7fc-4f99-8238-67b1a02f7c09" id="_f4b07a60-f7fc-4f99-8238-67b1a02f7c09"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>&#x6771;&#x6D77;&#x6797; can be read as T&#x14D;kairin or Sh&#x14D;ji.</p></div>
