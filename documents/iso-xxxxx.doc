      <div class="Section3"><a name="AnnexA" id="AnnexA"></a>
        <h1 class="Annex"><b>Annex B</b><br/>(normative)<br/><br/><b>Honorific types</b></h1>
        <div><a name="_general_7" id="_general_7"></a><p class="h2Annex">B.1 General</p><div><a name="_mister" id="_mister"></a><p class="h3Annex">B.1.1 Mister</p><table class="dl"><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Code</p></td><td valign="top">
    <p class="MsoNormal"><a name="_fff59dca-bcab-419c-835b-6fc371c4b630" id="_fff59dca-bcab-419c-835b-6fc371c4b630"></a>urn:iso:name:honorific:general:mr</p>
  </td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Description</p></td><td valign="top">
    <p class="MsoNormal"><a name="_16790479-015a-43b3-97b5-21b5518ced3f" id="_16790479-015a-43b3-97b5-21b5518ced3f"></a>commonly used English honorific for men</p>
  </td></tr></table>
<div class="example"><a name="_94b3bd4e-d3f6-4d7d-87a6-0c4dd2b5e341" id="_94b3bd4e-d3f6-4d7d-87a6-0c4dd2b5e341"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Mr. Smith</p></div>
<div class="example"><a name="_6ce471e3-728c-49a0-b23d-b2c8fe6e0e41" id="_6ce471e3-728c-49a0-b23d-b2c8fe6e0e41"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Mr Smith</p></div>
<p class="TableTitle" align="center">Table B.1</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_938d9c43-9b17-41b9-b440-1a76ebfd0afa" id="_938d9c43-9b17-41b9-b440-1a76ebfd0afa"></a><thead><tr><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Language</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Abbreviations</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Rendered</th><th align="left" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Position</th></tr></thead><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">en</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Mr, Mr.</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Mr</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Prefix</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">fr</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">M., Mssr.</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Monsieur</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Prefix</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">de</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;"></td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Herr</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">Prefix</td></tr></tbody></table></div></div>
<div><a name="_mrs" id="_mrs"></a><p class="h3Annex">B.1.2 Mrs</p><table class="dl"><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Code</p></td><td valign="top">
    <p class="MsoNormal"><a name="_c16b137e-71ef-431b-9d0e-195ca00b8702" id="_c16b137e-71ef-431b-9d0e-195ca00b8702"></a>urn:iso:name:honorific:general:mrs</p>
  </td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">Description</p></td><td valign="top">
    <p class="MsoNormal"><a name="_df5d9f5f-5f9b-4b6b-8953-bf815ab3701d" id="_df5d9f5f-5f9b-4b6b-8953-bf815ab3701d"></a>commonly used English honorific for women. Originated from &#x201C;Mistress&#x201D;.</p>
  </td></tr></table>
