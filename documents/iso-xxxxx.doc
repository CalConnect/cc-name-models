f7-a259-a36534eaf0cd" id="_a0ecf730-1b58-40f7-a259-a36534eaf0cd"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x912D;</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x91AB;&#x751F;</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">title</td></tr></tbody></table></div><p class="TableTitle" align="center">Table C.23</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_b9f804a3-5941-4366-9609-0025d99a4af7" id="_b9f804a3-5941-4366-9609-0025d99a4af7"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x963F;</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">&#x738B;</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;"></td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div></div></div></div>
        <div><a name="_colombian" id="_colombian"></a><p class="h2Annex">C.9 Colombian</p>

</div>
        <div><a name="_czech" id="_czech"></a><p class="h2Annex">C.10 Czech</p>

</div>
        <div><a name="_english" id="_english"></a><p class="h2Annex">C.11 English</p><p class="MsoNormal"><a name="_32d67a89-5ee8-483e-90ea-a44250a6c93b" id="_32d67a89-5ee8-483e-90ea-a44250a6c93b"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo18;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo18;" class="MsoListParagraphCxSpLast">
    family name
  </p>

<p class="MsoNormal"><a name="_0b2462bf-ff9b-4232-be06-97168ae23a98" id="_0b2462bf-ff9b-4232-be06-97168ae23a98"></a>English names are names used in, or originating in, England. In England as
elsewhere in the English-speaking world, a complete name usually consists of a
given name, commonly referred to as a first name or Christian name, and a (most
commonly patrilineal) family name or surname, also referred to as a last name.</p>
<p class="MsoNormal"><a name="_88b9c72b-d1e6-489f-ae6d-013cfbae837d" id="_88b9c72b-d1e6-489f-ae6d-013cfbae837d"></a>There can be several given names, some of these being often referred to as a
second name, or middle name(s).</p>
<p class="MsoNormal"><a name="_7a15d2c8-b07b-4932-b96b-cde9a8e8d0e8" id="_7a15d2c8-b07b-4932-b96b-cde9a8e8d0e8"></a>Double-barrelled names, compound surnames in English feature two words,
are often joined by a hyphen or hyphens.</p>
<div><a name="_typical_name_patterns" id="_typical_name_patterns"></a><p class="h3Annex">C.11.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.24</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_0355a317-be1f-4a3e-951d-0b7795412a19" id="_0355a317-be1f-4a3e-951d-0b7795412a19"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div>
</div>
<div><a name="_examples" id="_examples"></a><p class="h3Annex">C.11.2 Examples</p><div class="example"><a name="_35e9e31d-1ee3-4e18-8233-28ce4fe69082" id="_35e9e31d-1ee3-4e18-8233-28ce4fe69082"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Henry Hepburne-Scott</p></div>
<p class="MsoNormal"><a name="_7dbb2023-9da8-4dde-b5a3-b27830f749a2" id="_7dbb2023-9da8-4dde-b5a3-b27830f749a2"></a>Some families having as many as
three or four words making up their surname.</p>
<div class="example"><a name="_ae706a2f-e9d7-4758-a953-2633804e43fb" id="_ae706a2f-e9d7-4758-a953-2633804e43fb"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Charles Hepburn-Stuart-Forbes-Trefusis, 21st Baron Clinton.</p></div>
<p class="MsoNormal"><a name="_e69b3415-3209-4a14-813a-18aa125f5d81" id="_e69b3415-3209-4a14-813a-18aa125f5d81"></a>It is not unusual for compound surnames to be composed of separate words
not linked by a hyphen.</p>
<div class="example"><a name="_bf2d306c-4a90-4c10-8e67-5d139080deba" id="_bf2d306c-4a90-4c10-8e67-5d139080deba"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span></p>
  <p class="TableTitle" align="center">Table C.25</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_b130adb6-f13e-41c9-9a16-0c37e46b126d" id="_b130adb6-f13e-41c9-9a16-0c37e46b126d"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Iain</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.0pt;mso-border-bottom-alt:solid windowtext 1.0pt;">Duncan Smith</td></tr><tr><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div>
</div></div></div>
        <div><a name="_french" id="_french"></a><p class="h2Annex">C.12 French</p><p class="MsoNormal"><a name="_5e5aa978-9ce6-4822-baa8-0b1e37ba6e1f" id="_5e5aa978-9ce6-4822-baa8-0b1e37ba6e1f"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo19;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo19;" class="MsoListParagraphCxSpLast">
    given name
  </p>

<p class="MsoNormal"><a name="_41cd28eb-bbeb-429f-a6e4-38309be647e5" id="_41cd28eb-bbeb-429f-a6e4-38309be647e5"></a>French people have one, two or more given names (first names). One of them
is used in daily life.</p>
<div><a name="_typical_name_patterns_2" id="_typical_name_patterns_2"></a><p class="h3Annex">C.12.1 Typical name patterns</p><p class="TableTitle" align="center">Table C.26</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_996688be-6ff6-4132-a25d-8f62db2ff118" id="_996688be-6ff6-4132-a25d-8f62db2ff118"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td></tr></tbody></table></div>
<p class="TableTitle" align="center">Table C.27</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_f5c8e0fe-fed4-4850-8572-6822fd157bee" id="_f5c8e0fe-fed4-4850-8572-6822fd157bee"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div></div>
<div><a name="_examples_2" id="_examples_2"></a><p class="h3Annex">C.12.2 Examples</p><div class="example"><a name="_56e9ff5f-6ba3-488e-9952-de7139570feb" id="_56e9ff5f-6ba3-488e-9952-de7139570feb"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>&#x201C;Jacques Chirac&#x201D; instead of officially of Jacques Ren&#xE9; Chirac.</p></div>
<div class="example"><a name="_dc0a137d-26e2-4fa3-bf63-3ca85bff8fb9" id="_dc0a137d-26e2-4fa3-bf63-3ca85bff8fb9"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>&#x201C;Philippe P&#xE9;tain&#x201D; instead of officially of Henri Philippe P&#xE9;tain,
because Philippe was the given name that he used in daily
life.</p></div>
<p class="MsoNormal"><a name="_7698ecde-cdb1-4261-be3d-07c5e8986289" id="_7698ecde-cdb1-4261-be3d-07c5e8986289"></a>Middle names in the English sense do not exist, and middle initials are
never used for second or further given names.</p>
<div class="example"><a name="_d8557830-9f16-42d4-ac92-2de668c8a64c" id="_d8557830-9f16-42d4-ac92-2de668c8a64c"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>Claude All&#xE8;gre may be cited as &#x201C;Claude J. All&#xE8;gre&#x201D; in English-speaking
scientific publications, but not in French ones.</p></div></div></div>
        <div><a name="_german" id="_german"></a><p class="h2Annex">C.13 German</p><p class="MsoNormal"><a name="_0ff2a314-34a5-4046-87ab-daff11f3af15" id="_0ff2a314-34a5-4046-87ab-daff11f3af15"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo20;" class="MsoListParagraphCxSpFirst">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo20;" class="MsoListParagraphCxSpLast">
    given name
  </p>

<p class="MsoNormal"><a name="_63d97a47-1b04-4538-8669-24ef071cc728" id="_63d97a47-1b04-4538-8669-24ef071cc728"></a>Personal names in German-speaking Europe consist of one or several given names
(Vorname, plural Vornamen) and a surname (Nachname, Familienname). The Vorname
is usually gender-specific.</p>
<div><a name="_typical_name_patterns_3" id="_typical_name_patterns_3"></a><p class="h3Annex">C.13.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.28</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_e5693da0-af5b-4ec7-9f84-205d77cc49ee" id="_e5693da0-af5b-4ec7-9f84-205d77cc49ee"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div>
</div>
<div><a name="_examples_3" id="_examples_3"></a><p class="h3Annex">C.13.2 Examples</p><div class="example"><a name="_bf85c22d-c8a0-459b-ab36-35048087a15b" id="_bf85c22d-c8a0-459b-ab36-35048087a15b"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Otto Eduard Leopold F&#xFC;rst von Bismarck.</p></div>
<p class="MsoNormal"><a name="_4decc7cc-21c1-4441-9fe9-231c5e5bbd5f" id="_4decc7cc-21c1-4441-9fe9-231c5e5bbd5f"></a>The Vorname (in English forename) is usually given to a child by the parents
shortly after birth. It is common to give a child several Vornamen (forenames).</p>
<p class="MsoNormal"><a name="_44aca51d-7cde-4073-a66a-9ee6c814716b" id="_44aca51d-7cde-4073-a66a-9ee6c814716b"></a>The Rufname (&#x201C;appellation name&#x201D; or &#x201C;call name&#x201D;) is the given name
intended for everyday use, and is often underlined on official documents.</p>
<div class="example"><a name="_09273828-8a8c-4d74-801f-01845a36ca4a" id="_09273828-8a8c-4d74-801f-01845a36ca4a"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>The Rufname of the mathematician Amalie Emmy Noether is &#x201C;Emmy&#x201D;.</p></div></div></div>
        <div><a name="_greek" id="_greek"></a><p class="h2Annex">C.14 Greek</p>

</div>
        <div><a name="_hindu" id="_hindu"></a><p class="h2Annex">C.15 Hindu</p>

</div>
        <div><a name="_hungarian" id="_hungarian"></a><p class="h2Annex">C.16 Hungarian</p><p class="MsoNormal"><a name="_652262ed-5e7c-459c-a523-3492c4735600" id="_652262ed-5e7c-459c-a523-3492c4735600"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo21;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo21;" class="MsoListParagraphCxSpLast">
    family name
  </p>

<div><a name="_typical_name_patterns_4" id="_typical_name_patterns_4"></a><p class="h3Annex">C.16.1 Typical name patterns</p>

  <p class="TableTitle" align="center">Table C.29</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_ac91b560-1043-4789-882a-3294ccea8964" id="_ac91b560-1043-4789-882a-3294ccea8964"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td></tr></tbody></table></div>
</div>
<div><a name="_examples_4" id="_examples_4"></a><p class="h3Annex">C.16.2 Examples</p><div class="example"><a name="_1654884f-5282-4596-b07e-c87a20f07f23" id="_1654884f-5282-4596-b07e-c87a20f07f23"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>Kova&#x301;cs Ja&#x301;nos</p></div>
<div class="example"><a name="_c916f058-b8dd-43fb-8192-be41eee3f8a3" id="_c916f058-b8dd-43fb-8192-be41eee3f8a3"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>If there is more than one given name, they come in order of importance
after the family name:</p>
  <p style="mso-list:l3 level1 lfo22;" class="MsoListParagraphCxSpFirst">
    Kova&#x301;cs Ja&#x301;nos Alada&#x301;r
  </p>
</div>
<div class="example"><a name="_5ff4757b-2bf7-451c-9432-fa640990626c" id="_5ff4757b-2bf7-451c-9432-fa640990626c"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>There can be more than one family name, which can be written fully or abbreviated
into initials:</p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpFirst">
    Segesdy Kova&#x301;cs Ja&#x301;nos
  </p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpMiddle">
    Segesdy-Kova&#x301;cs Ja&#x301;nos
  </p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpMiddle">
    S.Kova&#x301;cs Ja&#x301;nos
  </p>
  <p style="mso-list:l3 level1 lfo23;" class="MsoListParagraphCxSpLast">
    Segesdy K. Ja&#x301;nos
  </p>
</div></div></div>
        <div><a name="_icelandic" id="_icelandic"></a><p class="h2Annex">C.17 Icelandic</p><p class="MsoNormal"><a name="_d857c543-ea5b-4f81-84f4-019deb8b40a6" id="_d857c543-ea5b-4f81-84f4-019deb8b40a6"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpMiddle">
    patronymic name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpMiddle">
    matronymic name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpMiddle">
    genonymic name
  </p>
  <p style="mso-list:l3 level1 lfo24;" class="MsoListParagraphCxSpLast">
    family name
  </p>

<p class="MsoNormal"><a name="_f10faa01-1df6-41df-808d-8636494881c9" id="_f10faa01-1df6-41df-808d-8636494881c9"></a>Icelandic names differ from most current Western family name systems by being
patronymic or occasionally matronymic: they indicate the father (or mother) of
the child and not the historic family lineage.</p>
<p class="MsoNormal"><a name="_076476c9-ed90-4c1a-b0cc-3e215568e809" id="_076476c9-ed90-4c1a-b0cc-3e215568e809"></a>Iceland&#x2019;s traditional name system was formerly used by all Nordic countries
except partly Finland.</p>
<p class="MsoNormal"><a name="_dedebc25-60cc-44f4-b3e4-3d46bf6ab1bc" id="_dedebc25-60cc-44f4-b3e4-3d46bf6ab1bc"></a>The Icelandic system is not based on family names
(although some people do have family names and might use both systems).
Generally, a person&#x2019;s second name indicates the first name of their father
(patronymic) or in some cases mother (matronymic). According to Icelandic
naming tradition, second names end in -son or -d&#xF3;ttir with few exceptions.</p>
<div><a name="_typical_name_patterns_5" id="_typical_name_patterns_5"></a><p class="h3Annex">C.17.1 Typical name patterns</p><p class="TableTitle" align="center">Table C.30</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_023f6919-0343-4da8-8cd6-1fe720866343" id="_023f6919-0343-4da8-8cd6-1fe720866343"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">patronymic or matronymic name</td></tr></tbody></table></div>
<p class="TableTitle" align="center">Table C.31</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_7dd38b46-1530-4d40-b0c3-78fae8b59305" id="_7dd38b46-1530-4d40-b0c3-78fae8b59305"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">patronymic or matronymic name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">genonymic name</td></tr></tbody></table></div>
<p class="TableTitle" align="center">Table C.32</p><div align="center"><table style="mso-table-lspace:15.0cm;margin-left:423.0pt;mso-table-rspace:15.0cm;margin-right:423.0pt;mso-table-bspace:14.2pt;mso-table-anchor-vertical:paragraph;mso-table-anchor-horizontal:column;mso-table-overlap:never;" class="MsoISOTable" border="1" cellspacing="0" cellpadding="0"><a name="_c245cc26-c35f-4d0b-94f7-dff1d5521a09" id="_c245cc26-c35f-4d0b-94f7-dff1d5521a09"></a><tbody><tr><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">given name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">patronymic or matronymic name</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">(genonymic name)</td><td align="left" style="border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;">family name</td></tr></tbody></table></div></div>
<div><a name="_examples_5" id="_examples_5"></a><p class="h3Annex">C.17.2 Examples</p><div class="example"><a name="_bd1eedbe-a1f2-40c5-9a0a-af1823d123d7" id="_bd1eedbe-a1f2-40c5-9a0a-af1823d123d7"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>J&#xF3;hanna Sigur&#xF0;ard&#xF3;ttir. &#x201C;J&#xF3;hanna, daughter of Sigur&#xF0;ur&#x201D;.</p></div>
<div class="example"><a name="_0cc77fcf-27d4-4ad2-b8af-68c3ae6e8079" id="_0cc77fcf-27d4-4ad2-b8af-68c3ae6e8079"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Matronymic. Hei&#xF0;ar Helguson, &#x201C;Helguson, son of Helga&#x201D;.</p></div>
<div class="example"><a name="_67dd9d6a-8131-46a5-81f3-ded11676b63a" id="_67dd9d6a-8131-46a5-81f3-ded11676b63a"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>&#xD6;rvar &#xDE;&#xF3;reyjarson Sm&#xE1;rason. (&#xD6;rvar, son of &#xDE;&#xF3;rey, son of Sm&#xE1;ri)</p></div>
<p class="MsoNormal"><a name="_81f52d52-da78-4156-8e5f-9aea312c8346" id="_81f52d52-da78-4156-8e5f-9aea312c8346"></a>Some family names do exist in Iceland, most commonly adaptations from last name
patronyms Icelanders took up when living abroad.</p>
<div class="example"><a name="_78b66091-c03d-4f99-8d73-a468f3d8d95a" id="_78b66091-c03d-4f99-8d73-a468f3d8d95a"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  4</span><span style="mso-tab-count:1">&#xA0; </span>Geir Haarde, Ei&#xF0;ur Sm&#xE1;ri Gu&#xF0;johnsen, Anita Briem.</p></div>
<div class="example"><a name="_8bd33a30-af0a-4672-8e93-7941042d84c6" id="_8bd33a30-af0a-4672-8e93-7941042d84c6"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  5</span><span style="mso-tab-count:1">&#xA0; </span>Nobel Prize-winning author Halld&#xF3;r Laxness, born as Halld&#xF3;r Gu&#xF0;j&#xF3;nsson.</p></div></div></div>
        <div><a name="_indian" id="_indian"></a><p class="h2Annex">C.18 Indian</p>

</div>
        <div><a name="_indonesian" id="_indonesian"></a><p class="h2Annex">C.19 Indonesian</p><p class="MsoNormal"><a name="_68eb1100-a701-4eb4-b014-041767a5da10" id="_68eb1100-a701-4eb4-b014-041767a5da10"></a>name components:</p>

  <p style="mso-list:l3 level1 lfo25;" class="MsoListParagraphCxSpFirst">
    given name
  </p>
  <p style="mso-list:l3 level1 lfo25;" class="MsoListParagraphCxSpMiddle">
    family name
  </p>
  <p style="mso-list:l3 level1 lfo25;" class="MsoListParagraphCxSpLast">
    patronymic name
  </p>

<p class="MsoNormal"><a name="_1bd52858-e106-4712-903e-3ebac2dedf33" id="_1bd52858-e106-4712-903e-3ebac2dedf33"></a>Indonesians generally use given names without a family name.
The majority of Indonesians do not have family names. Rather,
their given names are geographically and culturally specific.</p>
<p class="MsoNormal"><a name="_d9813596-3138-49be-97e2-be35cbee2e14" id="_d9813596-3138-49be-97e2-be35cbee2e14"></a>Some given names include a family name or a patronymic.</p>
<div><a name="_typical_name_patterns_6" id="_typical_name_patterns_6"></a><p class="h3Annex">C.19.1 Typical name patterns</p><p class="MsoNormal"><a name="_23aed6e9-6028-4dbb-93c9-92d9c6a822e9" id="_23aed6e9-6028-4dbb-93c9-92d9c6a822e9"></a>Indonesian names usually fall into one of the following categories:</p>

  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpFirst">
    Mononymic names
  </p>
  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpMiddle">
    Polynymic names without a family name
  </p>
  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpMiddle">
    Polynymic names with a family name
  </p>
  <p style="mso-list:l3 level1 lfo26;" class="MsoListParagraphCxSpLast">
    Polynymic names with patronymic
  </p>

<p class="MsoNormal"><a name="_16798f66-bf17-4c11-8113-1c1456722695" id="_16798f66-bf17-4c11-8113-1c1456722695"></a>An Indonesian name is often mis-represented in other cultures, such as:</p>

  <p style="mso-list:l3 level1 lfo27;" class="MsoListParagraphCxSpFirst">
    Netherlands: the word &#x201C;Onbekend&#x201D; (&#x201C;unknown&#x201D;) is assigned as a last name
  </p>
  <p style="mso-list:l3 level1 lfo27;" class="MsoListParagraphCxSpMiddle">
    Germany: the one-word name is used as both given name and surname
  </p>
  <p style="mso-list:l3 level1 lfo27;" class="MsoListParagraphCxSpLast">
    US: &#x201C;Fnu&#x201D; (family name unknown) is assigned as the first or given name, &#x201C;Lnu&#x201D; (last name unknown) is assigned as the family, surname or last name,
or the name is duplicated as the surname.
  </p>
</div>
<div><a name="_examples_6" id="_examples_6"></a><p class="h3Annex">C.19.2 Examples</p><div class="example"><a name="_616f875e-f1a2-4c84-9fa8-6f18fd1c2ab7" id="_616f875e-f1a2-4c84-9fa8-6f18fd1c2ab7"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  1</span><span style="mso-tab-count:1">&#xA0; </span>&#x201C;Mulyono&#x201D;, the original name of &#x201C;Joko Widodo&#x201D;</p></div>
<div class="example"><a name="_b0adb2c2-9253-44be-babe-bdc549901dcc" id="_b0adb2c2-9253-44be-babe-bdc549901dcc"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  2</span><span style="mso-tab-count:1">&#xA0; </span>Kusno Sosrodihardjo</p></div>
<div class="example"><a name="_8208df0f-d704-405f-a1d3-050b26e6549b" id="_8208df0f-d704-405f-a1d3-050b26e6549b"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  3</span><span style="mso-tab-count:1">&#xA0; </span>Fransiskus Xaverius Hadi Rudyatmo</p></div>
<div class="example"><a name="_27ada189-0561-4937-80be-9e0eecc0e8fa" id="_27ada189-0561-4937-80be-9e0eecc0e8fa"></a><p class="MsoNormal"><span class="example_label">EXAMPLE  4</span><span style="mso-tab-count:1">&#xA0; </span>Sudono Salim</p></div></div></div>
