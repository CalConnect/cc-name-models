@startuml

!include style.uml.inc

!definelong primitiveType(x)
rectangle x <<primitiveType>> {
}
!enddefinelong

!definelong dataType(x)
rectangle x <<dataType>> {
}
!enddefinelong

primitiveType(NaturalNumber)
primitiveType(String)
dataType(Iso639Code)
dataType(Iso15924Code)
dataType(Uri)

class LocalizedString {
  +text: String
  +script: Iso15924Code
  +language: Iso639Code
}

@enduml
